# ---------------------------------------------------------------------------
# Build-time values.
#
# Docker Compose reads these from `.env` in this directory and forwards them as
# build args. Changing any of them requires `docker compose build`, not just a
# restart.
#
# PUBLIC_* is SvelteKit's equivalent of Next's NEXT_PUBLIC_*: only variables
# with this prefix can be imported from `$env/static/public`, and the value is
# substituted into the client bundle at build time.
# PUBLIC_STRAPI_PROD_API_URL must be publicly reachable — it is what the browser
# uses for Strapi media URLs, and it is baked into the prerendered HTML.
# ---------------------------------------------------------------------------
PUBLIC_STRAPI_DEV_API_URL=http://localhost:1337
PUBLIC_STRAPI_PROD_API_URL=https://portfolio.pranta.dev

# ---------------------------------------------------------------------------
# Build-time secret. Every page is prerendered from Strapi during the build, so
# this is required to BUILD but is not read at runtime.
# ---------------------------------------------------------------------------
STRAPI_API_KEY=

# ---------------------------------------------------------------------------
# Build time AND runtime, optional. A GitHub token that can read public data
# (a fine-grained token with no extra permissions is enough).
#   - At build time it bakes fresh data into the home heatmap, the /open-source
#     diff sizes and the /about languages bar. Without it the committed
#     snapshot (src/lib/data/github.snapshot.json) is used.
#   - At runtime /api/github/activity uses it to keep the heatmap "live",
#     refetching at most once a day. Without it the heatmap keeps the build's
#     copy.
# Refresh the committed snapshot with:
#   GITHUB_TOKEN=$(gh auth token) bun scripts/refresh-github-snapshot.ts
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Runtime secrets. Everything lives in this one `.env`, which compose also
# injects into the container via `env_file`.
#   RESEND_API_KEY          POST /api/contact
#   STRAPI_REACTIONS_TOKEN  /api/reactions/[slug]. A Strapi API token of type
#                           "Custom" with only Post-reaction → find and react.
#                           Never the build key: that one is read-only.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
STRAPI_REACTIONS_TOKEN=

# ---------------------------------------------------------------------------
# Runtime, REQUIRED in production. adapter-node checks the Origin header on
# form POSTs as CSRF protection and cannot infer the public URL behind a proxy.
# Without it the contact form returns 403. Set in compose for the VPS; locally
# `vite dev` and `vite preview` handle it themselves.
# ---------------------------------------------------------------------------
# ORIGIN=https://pranta.dev

# ---------------------------------------------------------------------------
# Server-only, runtime-only. The blog reactions endpoint talks to Strapi at
# runtime; compose sets this so those calls stay on the Docker network.
# Unset, they go to the public Strapi URL instead, which also works.
# ---------------------------------------------------------------------------
# STRAPI_INTERNAL_URL=http://portfolio-strapi-cms:1337
