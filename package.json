{
  "name": "portfolio-svelte-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "bunx rimraf .svelte-kit build",
    "dev": "vite dev",
    "prebuild": "bun clean",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@lucide/svelte": "1.56.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.9.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "^16.4.0",
    "husky": "^9.0.11",
    "lenis": "1.3.26",
    "lint-staged": "^15.2.7",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "clsx": "^2.1.1",
    "resend": "^4.0.0",
    "satori": "0.52.0"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": "eslint --cache --fix",
    "*": "bun format:fix"
  },
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/lib/components/*"
  },
  "patchedDependencies": {
    "@sveltejs/kit@3.0.1": "patches/@sveltejs%2Fkit@3.0.1.patch"
  }
}
